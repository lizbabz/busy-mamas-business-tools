# ============================================================================
# MOMPRENEUR BUSINESS IDEA FINDER - CONFIGURATION (.env)
# Copy this file to .env and fill in your credentials
# ============================================================================

# 1. GOOGLE SHEETS VAULT CONNECTION
# Paste either your full Google Sheet URL or just the Spreadsheet ID.
# Tip: Set your Google Sheet sharing to "Anyone with the link can view" for instant zero-auth live syncing!
GOOGLE_SHEET_URL=""
GOOGLE_SHEET_ID=""
GOOGLE_SHEET_TAB_NAME="Sheet1"
# Optional: Google Cloud API Key (only needed if using Google Sheets v4 REST API directly instead of public link)
GOOGLE_SHEETS_API_KEY=""

# Optional: Google Apps Script Webhook URL (if you want new email leads automatically added to a "Leads" tab in your Google Sheet)
GOOGLE_SHEETS_LEADS_WEBHOOK_URL=""

# 2. KIT (CONVERTKIT) EMAIL MARKETING INTEGRATION
# Found in Kit -> Settings -> Developer (API Key & Secret) and Forms (Form ID in the form URL)
KIT_API_KEY=""
KIT_API_SECRET=""
KIT_FORM_ID=""
# Optional: Kit Tag ID to tag leads who complete the Business Idea Finder
KIT_TAG_ID=""

# 3. 1-ON-1 CONSULTING UPSELL (CALENDLY)
# Your Calendly scheduling link (e.g., https://calendly.com/your-name/strategy-call)
CALENDLY_URL="https://calendly.com/nvmbrmedia/strategy-session-with-oyin"
CONSULTING_TITLE="1-on-1 Mompreneur Launch & Income Roadmap Session"
CONSULTING_SUBTITLE="Skip months of nap-time guesswork. Let's turn your #1 matched idea into your first paying clients."
CONSULTING_PRICE_TEXT="Limited 1-on-1 spots available this month"
CONSULTING_CTA_TEXT="Book Your 1-on-1 Strategy Call"

# 4. AI PERSONALIZATION ENGINE (HYBRID RECOMMENDATIONS)
# Supports Google Gemini (Recommended: fast & <$0.001/lead) or OpenAI
# If left blank, the tool automatically uses the built-in Smart Income-Math & Strategy Generator!
AI_PROVIDER="gemini" # "gemini" or "openai"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# 5. SERVER PORT
PORT=3000
